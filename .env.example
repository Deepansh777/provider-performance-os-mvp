# Database Configuration
DATABASE_URL=postgresql://vbp_user:vbp_password@db:5432/vbp_database
POSTGRES_USER=vbp_user
POSTGRES_PASSWORD=vbp_password
POSTGRES_DB=vbp_database

# Backend Configuration
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000

# Development Mode - Set to 'true' to bypass authentication (DEV ONLY! Never use in production)
REACT_APP_DISABLE_AUTH=false

# AWS Cognito Configuration
# Get your App Client ID from: AWS Console → Cognito → User Pool → App Integration → App clients
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_zk3y8XtoK
COGNITO_APP_CLIENT_ID=your_app_client_id_here

# JWT Configuration (Not needed with Cognito, kept for reference)
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
